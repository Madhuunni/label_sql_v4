{"question": "List employee name and salary", "plan": {"select": [{"column": "Employee name"}, {"column": "Salary"}]}, "source": "hand-authored demonstration"}
{"question": "Show employee name and department name", "plan": {"select": [{"column": "Employee name"}, {"column": "Department name"}]}, "source": "hand-authored demonstration"}
{"question": "Show case ID with department name", "plan": {"select": [{"column": "Case ID"}, {"column": "Department name"}]}, "source": "hand-authored demonstration"}
{"question": "Which employee name has salary above 60000?", "plan": {"select": [{"column": "Employee name"}], "where": {"column": "Salary", "op": "gt", "value": 60000}}, "source": "hand-authored demonstration"}
{"question": "Show case ID for case status Open", "plan": {"select": [{"column": "Case ID"}], "where": {"column": "Case status", "op": "eq", "value": "Open"}}, "source": "hand-authored demonstration"}
{"question": "Show employee name for department name Finance", "plan": {"select": [{"column": "Employee name"}], "where": {"column": "Department name", "op": "eq", "value": "Finance"}}, "source": "hand-authored demonstration"}
{"question": "Show average salary by department name", "plan": {"select": [{"column": "Department name"}, {"column": "Salary", "aggregate": "avg"}], "group_by": ["Department name"]}, "source": "hand-authored demonstration"}
{"question": "Show total overpayment amount by department name", "plan": {"select": [{"column": "Department name"}, {"column": "Overpayment amount", "aggregate": "sum"}], "group_by": ["Department name"]}, "source": "hand-authored demonstration"}
{"question": "Show count of case ID by case status", "plan": {"select": [{"column": "Case status"}, {"column": "Case ID", "aggregate": "count"}], "group_by": ["Case status"]}, "source": "hand-authored demonstration"}
