{"question": "Show highest 5 salary values with employee name", "plan": {"select": [{"column": "Employee name"}, {"column": "Salary"}], "order_by": [{"column": "Salary", "direction": "desc"}], "limit": 5}, "source": "hand-authored demonstration"}
{"question": "Show case ID where opened date is on or after 2026-01-01", "plan": {"select": [{"column": "Case ID"}], "where": {"column": "Opened date", "op": "gte", "value": "2026-01-01"}}, "source": "hand-authored demonstration"}
{"question": "Show employee name beginning with A ignoring case", "plan": {"select": [{"column": "Employee name"}], "where": {"column": "Employee name", "op": "ilike", "value": "A%"}}, "source": "hand-authored demonstration"}
{"question": "Show case ID for case status Open or Pending", "plan": {"select": [{"column": "Case ID"}], "where": {"column": "Case status", "op": "in", "value": ["Open", "Pending"]}}, "source": "hand-authored demonstration"}
{"question": "Show employee name with salary between 50000 and 80000 inclusive", "plan": {"select": [{"column": "Employee name"}], "where": {"and": [{"column": "Salary", "op": "gte", "value": 50000}, {"column": "Salary", "op": "lte", "value": 80000}]}}, "source": "hand-authored demonstration"}
{"question": "Show department name and total salary where total salary exceeds 100000", "plan": {"select": [{"column": "Department name"}, {"column": "Salary", "aggregate": "sum"}], "group_by": ["Department name"], "having": {"column": "Salary", "aggregate": "sum", "op": "gt", "value": 100000}}, "source": "hand-authored demonstration"}
